///|
test "finds metadata and tiles root pages" {
  match @mbtiles.Mbtiles::from_bytes(mbtiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) => {
      assert_true(file.metadata_root() >= 1)
      assert_true(file.tiles_root() >= 1)
      assert_true(file.metadata_root() != file.tiles_root())
    }
  }
}

///|
test "reads metadata key value pairs" {
  match @mbtiles.Mbtiles::from_bytes(mbtiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) =>
      match file.metadata_pairs() {
        Err(_) => assert_true(false)
        Ok(pairs) => {
          assert_eq(pairs.length(), 2)
          let (k0, v0) = pairs[0]
          assert_eq(k0, "name")
          assert_eq(v0, "demo")
          let (k1, v1) = pairs[1]
          assert_eq(k1, "format")
          assert_eq(v1, "png")
        }
      }
  }
}

///|
test "looks up a metadata key" {
  match @mbtiles.Mbtiles::from_bytes(mbtiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) => {
      match file.metadata("format") {
        Err(_) => assert_true(false)
        Ok(found) =>
          match found {
            Some(v) => assert_eq(v, "png")
            None => assert_true(false)
          }
      }
      match file.metadata("missing") {
        Err(_) => assert_true(false)
        Ok(found) =>
          match found {
            Some(_) => assert_true(false)
            None => assert_true(true)
          }
      }
    }
  }
}

///|
test "rejects bytes that are not a database" {
  match @mbtiles.Mbtiles::from_bytes(b"\x50") {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

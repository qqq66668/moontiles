}

///|
test "counts tile rows" {
  match @mbtiles.Mbtiles::from_bytes(tiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) =>
      match file.tile_row_count() {
        Err(_) => assert_true(false)
        Ok(count) => assert_eq(count, 2)
      }
  }
}

///|
test "reads the zoom 0 tile" {
  match @mbtiles.Mbtiles::from_bytes(tiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) =>
      match file.tile(0, 0, 0) {
        Err(_) => assert_true(false)
        Ok(found) =>
          match found {
            Some(bytes) => {
              assert_eq(bytes.length(), 2)
              assert_eq(bytes.unsafe_get(0).to_int(), 0xde)
              assert_eq(bytes.unsafe_get(1).to_int(), 0xad)
            }
            None => assert_true(false)
          }
      }
  }
}

///|
test "flips the row into tms order" {
  match @mbtiles.Mbtiles::from_bytes(tiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) =>
      match file.tile(1, 1, 1) {
        Err(_) => assert_true(false)
        Ok(found) =>
          match found {
            Some(bytes) => {
              assert_eq(bytes.length(), 2)
              assert_eq(bytes.unsafe_get(0).to_int(), 0xbe)
              assert_eq(bytes.unsafe_get(1).to_int(), 0xef)
            }
            None => assert_true(false)
          }
      }
  }
}

///|
test "missing tile returns none" {
  match @mbtiles.Mbtiles::from_bytes(tiles_fixture()) {
    Err(_) => assert_true(false)
    Ok(file) =>
      match file.tile(1, 1, 0) {
        Err(_) => assert_true(false)
        Ok(found) =>
          match found {
            Some(_) => assert_true(false)
            None => assert_true(true)
          }
      }
  }
}

///|
/// 打印一行“标签 + 数值”。
fn report(label : String, value : Int32) -> Unit {
  println(label + value.to_string())
}

///|
/// 读取一个瓦片并打印其字节长度。
fn show_tile(
  file : @pmtiles.PmtilesFile,
  z : Int32,
  x : Int32,
  y : Int32,
) -> Unit {
  match file.tile(z, x, y) {
    Err(msg) => println(msg)
    Ok(value) =>
      match value {
        None => println("tile not found")
        Some(bytes) => report("tile length", bytes.length())
      }
  }
}

///|
/// 解析内置样例并打印头部、根目录与瓦片摘要。
fn demo() -> Unit {
  let data : Bytes = b"\x50\x4d\x54\x69\x6c\x65\x73\x03\x7f\x00\x00\x00\x00\x00\x00\x00\x19\x00\x00\x00\x00\x00\x00\x00\x98\x00\x00\x00\x00\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\xb0\x00\x00\x00\x00\x00\x00\x00\x22\x00\x00\x00\x00\x00\x00\x00\xd2\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x01\x02\x01\x01\x00\x01\x00\x2e\xb6\x94\x48\x3a\x4e\xcd\x00\xd2\x49\x6b\xb8\xc5\xb1\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\x63\x64\x60\x50\x62\x04\x00\x1b\xa8\xf7\x2b\x05\x00\x00\x00\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xcb\x4d\x2d\x49\x04\x00\x35\x14\xf2\xd7\x04\x00\x00\x00\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\x63\x61\x60\x64\x64\x62\x04\x02\x26\x20\x60\x64\x60\x60\x00\x00\x2f\x36\xd3\x06\x11\x00\x00\x00\x7a\x30\x61\x61\x62\x62\x63\x63"
  match @pmtiles.PmtilesFile::from_bytes(data) {
    Err(msg) => println(msg)
    Ok(file) => {
      println("moontiles demo")
      let header = file.header()
      report("spec version", header.spec_version)
      report("min zoom", header.min_zoom)
      report("max zoom", header.max_zoom)
      report("root entries", file.root_entry_count())
      report("tile data length", @pmtiles.u64_to_int(header.tile_data_length))
      show_tile(file, 0, 0, 0)
      show_tile(file, 1, 0, 0)
      show_tile(file, 1, 0, 1)
      show_tile(file, 1, 1, 0)
      show_tile(file, 1, 1, 1)
    }
  }
}


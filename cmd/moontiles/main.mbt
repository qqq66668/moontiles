  match @mbtiles.Mbtiles::from_bytes(data) {
    Err(msg) => println(msg)
    Ok(file) => {
      println("moontiles mbtiles demo")
      match file.metadata_pairs() {
        Err(msg) => println(msg)
        Ok(pairs) => report("metadata pairs", pairs.length())
      }
      match file.metadata("format") {
        Err(msg) => println(msg)
        Ok(found) =>
          match found {
            Some(v) => println("format=" + v)
            None => println("format missing")
          }
      }
      match file.tile_row_count() {
        Err(msg) => println(msg)
        Ok(count) => report("tile rows", count)
      }
      match file.tile(0, 0, 0) {
        Err(msg) => println(msg)
        Ok(found) =>
          match found {
            Some(bytes) => report("tile length", bytes.length())
            None => println("tile missing")
          }
      }
    }
  }
}

///|
fn main {
  demo()
  demo_mbtiles()
}

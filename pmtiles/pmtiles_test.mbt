  let data : Bytes = b"\x50\x4d\x54\x69\x6c\x65\x73\x02\x7f\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\xe3\x00\x00\x00\x00\x00\x00\x00\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x15\x01\x00\x00\x00\x00\x00\x00\xe8\x03\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x02\x02\x01\x00\x05\x00\x2e\xb6\x94\x48\x3a\x4e\xcd\x00\xd2\x49\x6b\xb8\xc5\xb1\x32\x02\x00\x00\x00\x00\x00\x00\x00\x00"
  match @pmtiles.parse_header(data) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

///|
test "rejects an unknown tile type" {
  let data : Bytes = b"\x50\x4d\x54\x69\x6c\x65\x73\x03\x7f\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\xe3\x00\x00\x00\x00\x00\x00\x00\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x15\x01\x00\x00\x00\x00\x00\x00\xe8\x03\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x02\x02\x09\x00\x05\x00\x2e\xb6\x94\x48\x3a\x4e\xcd\x00\xd2\x49\x6b\xb8\xc5\xb1\x32\x02\x00\x00\x00\x00\x00\x00\x00\x00"
  match @pmtiles.parse_header(data) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

///|
test "rejects an inverted zoom range" {
  let data : Bytes = b"\x50\x4d\x54\x69\x6c\x65\x73\x03\x7f\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\xe3\x00\x00\x00\x00\x00\x00\x00\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x15\x01\x00\x00\x00\x00\x00\x00\xe8\x03\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x02\x02\x01\x07\x03\x00\x2e\xb6\x94\x48\x3a\x4e\xcd\x00\xd2\x49\x6b\xb8\xc5\xb1\x32\x02\x00\x00\x00\x00\x00\x00\x00\x00"
  match @pmtiles.parse_header(data) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

///|
test "maps compression and tile type names" {
  assert_eq(@pmtiles.compression_name(1), "none")
  assert_eq(@pmtiles.compression_name(2), "gzip")
  assert_eq(@pmtiles.compression_name(4), "zstd")
  assert_eq(@pmtiles.compression_name(9), "unknown")
  assert_eq(@pmtiles.tile_type_name(1), "mvt")
  assert_eq(@pmtiles.tile_type_name(5), "avif")
  assert_eq(@pmtiles.tile_type_name(9), "unknown")
  assert_eq(@pmtiles.header_size(), 127)
}

///|
fn valid_header() -> Bytes {
  b"\x50\x4d\x54\x69\x6c\x65\x73\x03\x7f\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\xe3\x00\x00\x00\x00\x00\x00\x00\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x15\x01\x00\x00\x00\x00\x00\x00\xe8\x03\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x02\x02\x01\x00\x05\x00\x2e\xb6\x94\x48\x3a\x4e\xcd\x00\xd2\x49\x6b\xb8\xc5\xb1\x32\x02\x00\x00\x00\x00\x00\x00\x00\x00"
}

///|
test "parses a valid header" {
  let data = valid_header()
  assert_eq(data.length(), 127)
  match @pmtiles.parse_header(data) {
    Ok(h) => {
      assert_eq(h.spec_version, 3)
      assert_eq(h.root_dir_offset, @pmtiles.u64_from_int(127))
      assert_eq(h.root_dir_length, @pmtiles.u64_from_int(100))
      assert_eq(h.metadata_offset, @pmtiles.u64_from_int(227))
      assert_eq(h.metadata_length, @pmtiles.u64_from_int(50))
      assert_eq(h.leaf_dir_offset, @pmtiles.u64_from_int(0))
      assert_eq(h.leaf_dir_length, @pmtiles.u64_from_int(0))
      assert_eq(h.tile_data_offset, @pmtiles.u64_from_int(277))
      assert_eq(h.tile_data_length, @pmtiles.u64_from_int(1000))
      assert_eq(h.addressed_tiles_count, @pmtiles.u64_from_int(5))
      assert_eq(h.tile_entries_count, @pmtiles.u64_from_int(3))
      assert_eq(h.tile_contents_count, @pmtiles.u64_from_int(2))
      assert_true(h.clustered)
      assert_eq(h.internal_compression, 2)
      assert_eq(h.tile_compression, 2)
      assert_eq(h.tile_type, 1)
      assert_eq(h.min_zoom, 0)
      assert_eq(h.max_zoom, 5)
      assert_eq(h.min_lon_e7, -1800000000)
      assert_eq(h.min_lat_e7, -850511288)
      assert_eq(h.max_lon_e7, 1800000000)
      assert_eq(h.max_lat_e7, 850511288)
      assert_eq(h.center_zoom, 2)
      assert_eq(h.center_lon_e7, 0)
      assert_eq(h.center_lat_e7, 0)
    }
    Err(_) => assert_true(false)
  }
}

///|
test "rejects a truncated header" {
  let data : Bytes = b"\x50\x4d\x54\x69\x6c\x65\x73\x03\x7f\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00"
  match @pmtiles.parse_header(data) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

///|
test "rejects a wrong magic string" {
  let data : Bytes = b"\x51\x4d\x54\x69\x6c\x65\x73\x03\x7f\x00\x00\x00\x00\x00\x00\x00\x64\x00\x00\x00\x00\x00\x00\x00\xe3\x00\x00\x00\x00\x00\x00\x00\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x15\x01\x00\x00\x00\x00\x00\x00\xe8\x03\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x02\x02\x01\x00\x05\x00\x2e\xb6\x94\x48\x3a\x4e\xcd\x00\xd2\x49\x6b\xb8\xc5\xb1\x32\x02\x00\x00\x00\x00\x00\x00\x00\x00"
  match @pmtiles.parse_header(data) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}


}

///|
test "walks the metadata table" {
  match @sqlite.parse_db_header(db_fixture()) {
    Err(_) => assert_true(false)
    Ok(db) =>
      match @sqlite.read_table_rows(db_fixture(), db, 2) {
        Err(_) => assert_true(false)
        Ok(rows) => {
          assert_eq(rows.length(), 2)
          let mut i = 0
          while i < rows.length() {
            match @sqlite.decode_record(rows[i]) {
              Err(_) => assert_true(false)
              Ok(values) => {
                assert_eq(values.length(), 2)
                assert_eq(values[0].kind, 3)
                assert_eq(values[1].kind, 3)
              }
            }
            i = i + 1
          }
        }
      }
  }
}

///|
test "rejects a root page beyond the file" {
  match @sqlite.parse_db_header(db_fixture()) {
    Err(_) => assert_true(false)
    Ok(db) => {
      match @sqlite.read_table_rows(db_fixture(), db, db.page_count + 1) {
        Ok(_) => assert_true(false)
        Err(_) => assert_true(true)
      }
      match @sqlite.read_table_rows(db_fixture(), db, 0) {
        Ok(_) => assert_true(false)
        Err(_) => assert_true(true)
      }
    }
  }
}

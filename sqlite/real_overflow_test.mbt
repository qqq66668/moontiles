///|
test "decodes real columns from a real database" {
  match @sqlite.parse_db_header(real_overflow_db()) {
    Err(_) => assert_true(false)
    Ok(db) =>
      match @sqlite.read_table_values(real_overflow_db(), db, 2) {
        Err(_) => assert_true(false)
        Ok(rows) => {
          assert_eq(rows.length(), 2)
          assert_eq(rows[0].length(), 1)
          assert_eq(rows[0][0].kind, 2)
          assert_eq(rows[0][0].real_value, 1.5)
          assert_eq(rows[1][0].real_value, 0.0 - 3.25)
        }
      }
  }
}

///|
test "reads a payload that spills into overflow pages" {
  match @sqlite.parse_db_header(real_overflow_db()) {
    Err(_) => assert_true(false)
    Ok(db) =>
      match @sqlite.read_table_values(real_overflow_db(), db, 3) {
        Err(_) => assert_true(false)
        Ok(rows) => {
          assert_eq(rows.length(), 1)
          assert_eq(rows[0].length(), 1)
          assert_eq(rows[0][0].kind, 4)
          let blob = rows[0][0].bytes
          assert_eq(blob.length(), 3000)
          assert_eq(blob.unsafe_get(0).to_int(), 0x00)
          assert_eq(blob.unsafe_get(1).to_int(), 0x07)
          assert_eq(blob.unsafe_get(7).to_int(), 0x31)
          assert_eq(blob.unsafe_get(1496).to_int(), 0xe8)
          assert_eq(blob.unsafe_get(1503).to_int(), 0x19)
          assert_eq(blob.unsafe_get(2999).to_int(), 0x01)
        }
      }
  }
}

///|
test "reports local length and overflow page for a spilled cell" {
  match @sqlite.parse_db_header(real_overflow_db()) {
    Err(_) => assert_true(false)
    Ok(db) => {
      let page_start = (3 - 1) * db.page_size
      match
        @sqlite.read_leaf_table_cells(
          real_overflow_db(),
          page_start,
          db.page_size,
          reserved=db.reserved_bytes,
        ) {
        Err(_) => assert_true(false)
        Ok(cells) => {
          assert_eq(cells.length(), 1)
          assert_true(cells[0].payload_length > 3000)
          assert_true(cells[0].local_length < cells[0].payload_length)
          assert_true(cells[0].overflow_page > 0)
        }
      }
    }
  }
}

///|
test "keeps small payloads entirely local" {
  match @sqlite.parse_db_header(real_overflow_db()) {
    Err(_) => assert_true(false)
    Ok(db) => {
      let page_start = (2 - 1) * db.page_size
      match
        @sqlite.read_leaf_table_cells(
          real_overflow_db(),
          page_start,
          db.page_size,
          reserved=db.reserved_bytes,
        ) {
        Err(_) => assert_true(false)
        Ok(cells) => {
          assert_eq(cells.length(), 2)
          assert_eq(cells[0].local_length, cells[0].payload_length)
          assert_eq(cells[0].overflow_page, 0)
        }
      }
    }
  }
}

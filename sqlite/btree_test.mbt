///|
test "parses a real b-tree page header" {
  let page = btree_fixture()
  assert_eq(page.length(), 512)
  match @sqlite.parse_page_header(page, 0) {
    Err(_) => assert_true(false)
    Ok(header) => {
      assert_eq(header.page_type, 13)
      assert_eq(header.first_freeblock, 0)
      assert_eq(header.cell_count, 2)
      assert_eq(header.cell_content_start, 318)
      assert_eq(header.fragmented_free_bytes, 0)
      assert_eq(header.header_size, 8)
    }
  }
}

///|
test "reads the cell pointer array" {
  match @sqlite.parse_page_header(btree_fixture(), 0) {
    Err(_) => assert_true(false)
    Ok(header) =>
      match @sqlite.cell_pointers(btree_fixture(), 0, header) {
        Err(_) => assert_true(false)
        Ok(pointers) => {
          assert_eq(pointers.length(), 2)
          let expected : Array[Int32] = [437, 318]
          let mut i = 0
          while i < expected.length() {
            assert_eq(pointers[i], expected[i])
            i = i + 1
          }
        }
      }
  }
}

///|
test "first page header starts after the database header" {
  match @sqlite.parse_db_header(header_fixture()) {
    Err(_) => assert_true(false)
    Ok(db) => {
      assert_eq(@sqlite.page_header_start(1, db), 100)
      assert_eq(@sqlite.page_header_start(2, db), db.page_size)
      assert_eq(@sqlite.page_header_start(3, db), db.page_size * 2)
    }
  }
}

///|
test "rejects a truncated page header" {
  match @sqlite.parse_page_header(take(btree_fixture(), 4), 0) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

///|
test "rejects an unknown page type" {
  let page = with_byte(btree_fixture(), 0, b'\x00')
  match @sqlite.parse_page_header(page, 0) {
    Ok(_) => assert_true(false)
    Err(_) => assert_true(true)
  }
}

///|
test "rejects a cell pointer array beyond the page" {
  let page = with_byte(btree_fixture(), 4, b'\xff')
  match @sqlite.parse_page_header(page, 0) {
    Err(_) => assert_true(false)
    Ok(header) => {
      assert_true(header.cell_count > 2)
      match @sqlite.cell_pointers(page, 0, header) {
        Ok(_) => assert_true(false)
        Err(_) => assert_true(true)
      }
    }
  }
}
